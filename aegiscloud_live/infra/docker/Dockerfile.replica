# One replica = one container of this image. Build context is the project root (see .dockerignore).
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN pip install --no-cache-dir fastapi "uvicorn[standard]" numpy psutil pydantic
COPY settings.py ./settings.py
COPY traffic ./traffic
COPY infra/__init__.py ./infra/__init__.py
COPY infra/replica_app.py ./infra/replica_app.py
EXPOSE 8001
CMD ["python", "-m", "uvicorn", "infra.replica_app:app", "--host", "0.0.0.0", "--port", "8001", "--log-level", "warning"]
